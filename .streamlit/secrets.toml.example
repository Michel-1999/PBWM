# ---------------------------------------------------------------------------
# The Bank — secrets template.
# Copy this file to ".streamlit/secrets.toml" and fill in the values below.
#   PowerShell:  Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
#   macOS/Linux: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# secrets.toml is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Google Gemini (FREE tier — no credit card required).
# Get a key at https://aistudio.google.com  ->  "Get API key".
# Leave the placeholder as-is to run the app in OFFLINE MOCK MODE (canned AI
# answers, no network) — the whole prototype still demos end-to-end.
GEMINI_API_KEY = "PASTE_YOUR_FREE_AISTUDIO_KEY_HERE"

# Adobe Fonts (Typekit) web-project kit id for the brand serif "Mendl Serif".
# A kit id is public by design; one is already set in code, so this is optional.
# Leave blank to use the built-in default (or the Georgia fallback if offline).
ADOBE_FONTS_KIT_ID = ""

# Optional access password. If set, visitors must enter it before the app opens
# (recommended when you embed your own GEMINI_API_KEY on a public deployment).
# Leave blank for an open app (e.g. local development).
APP_PASSWORD = ""
